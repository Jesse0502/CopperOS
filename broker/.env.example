# Ollama connection. Start the server with `ollama serve` (the desktop app does
# this for you) and check `ollama list` for the models you actually have.
OLLAMA_MODEL=minimax-m3:cloud
OLLAMA_HOST=http://127.0.0.1:11434

# Context window in tokens. Ollama defaults far lower than this app needs — an
# accessibility snapshot alone can run several thousand tokens.
OLLAMA_NUM_CTX=32768

# all | submits | none — which actions need your approval in the popup.
APPROVAL_MODE=submits

# Broker WebSocket port. Must match BROKER_URL in extension/background.js.
PORT=7331
