# Ollama connection. Start the server with `ollama serve` (the desktop app does
# this for you) and check `ollama list` for the models you actually have.
OLLAMA_MODEL=minimax-m3:cloud
OLLAMA_HOST=http://127.0.0.1:11434

# Context window in tokens. Ollama defaults far lower than this app needs — an
# accessibility snapshot alone can run several thousand tokens.
OLLAMA_NUM_CTX=32768

# Optional. OpenRouter (openrouter.ai) — one key for hundreds of hosted
# models. Pick "OpenRouter" as the provider in the extension's Settings page;
# the model list there shows only models that support tool calling.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# all | submits | none — which actions need your approval in the popup.
APPROVAL_MODE=submits

# Broker WebSocket port. Must match BROKER_URL in extension/background.js.
PORT=7331

# Optional. Jev AI (typesafe.ai) API key — enables the shadow classifiers, re-ranks, search_memory and classifyIntent (skips the main model's reasoning effort on a greeting/aside
# turn), and task rounds: a multi-part task ("apply to 10 jobs") keeps getting
# fresh-context rounds until Jev judges it finished, with progress saved under
# storage/progress/, and check-ins that keep the model to the instructions.
# Leave unset to disable all of it; nothing else depends on it.
JEV_AI_API_KEY=

# Optional. Most rounds one message can start while Jev keeps saying there is
# more to do. Default 15.
# TASK_MAX_ROUNDS=15

# Optional, with Jev. Every this many steps of a tracked task the model stops
# to say what it is doing; Jev checks that, and its recent actions, against
# the user's instructions and corrects it if it has drifted. 0 turns it off.
# CHECK_IN_EVERY=10

# Optional, with Jev. Once a round's context passes this many tokens, its next
# check-in hands the task over to a fresh round, so a long task or a long chat
# does not bury the instructions.
# FRESH_CONTEXT_TOKENS=25000
