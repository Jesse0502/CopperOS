{
  "manifest_version": 3,
  "name": "CopperOS: Automate your browser with AI",
  "version": "1.1.2",
  "description": "CopperOS is an Open-Source Agentic Browser Extension that lets AI perform tasks on your browser.",
  "homepage_url": "https://copper.jassydev.com",
  "permissions": [
    "tabs",
    "debugger",
    "storage",
    "alarms",
    "scripting",
    "tabGroups",
    "sidePanel",
    "identity"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://copper.jassydev.com/*"],
      "js": ["website-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "CopperOS",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
